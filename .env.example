# FalkorDB connection (defaults work with docker-compose)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# LLM Provider: "openai", "google", or "deterministic" (no API key needed)
LLM_PROVIDER=deterministic

# OpenAI (optional — only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Google Gemini (optional — only needed if LLM_PROVIDER=google)
GOOGLE_API_KEY=...

# App settings
GRAPH_NAME=traceguard
LOG_LEVEL=INFO
